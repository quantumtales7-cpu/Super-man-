<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Universe AI</title>
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Markdown & Code Highlighting -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>

    <style>
        :root {
            --bg-color: #0b0f19;
            --panel-bg: rgba(17, 24, 39, 0.65);
            --glass-border: rgba(255, 255, 255, 0.08);
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --user-msg: rgba(99, 102, 241, 0.15);
            --ai-msg: rgba(30, 41, 59, 0.5);
            --danger: #ef4444;
            --success: #10b981;
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            height: 100vh;
            overflow: hidden;
            display: flex;
        }

        /* --- Backgrounds --- */
        #particles {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .aurora {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 0;
            pointer-events: none;
            background: 
                radial-gradient(circle at 15% 50%, rgba(99, 102, 241, 0.15), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(168, 85, 247, 0.15), transparent 25%);
            filter: blur(60px);
            animation: aurora-anim 20s infinite alternate linear;
        }

        @keyframes aurora-anim {
            0% { transform: scale(1); }
            100% { transform: scale(1.2) translate(50px, 50px); }
        }

        /* --- Layout & Glassmorphism --- */
        .glass {
            background: var(--panel-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
        }

        .sidebar {
            width: 280px;
            height: 100%;
            display: flex;
            flex-direction: column;
            z-index: 10;
            border-right: 1px solid var(--glass-border);
            transition: var(--transition);
        }

        .main-content {
            flex: 1;
            height: 100%;
            position: relative;
            z-index: 5;
            display: flex;
            flex-direction: column;
        }

        /* --- Sidebar UI --- */
        .logo-area {
            padding: 24px;
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 12px;
            background: linear-gradient(to right, #a855f7, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            flex: 1;
            padding: 12px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            padding: 12px 16px;
            border-radius: var(--radius-md);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 14px;
            color: var(--text-muted);
            transition: var(--transition);
            text-decoration: none;
        }

        .nav-item:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-main);
        }

        .nav-item.active {
            background: rgba(99, 102, 241, 0.2);
            color: #818cf8;
            border: 1px solid rgba(99, 102, 241, 0.3);
        }

        /* --- Views System (SPA) --- */
        .view-container {
            display: none;
            width: 100%;
            height: 100%;
            flex-direction: column;
            animation: fadeIn 0.4s ease forwards;
        }

        .view-container.active {
            display: flex;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* --- Header --- */
        .top-nav {
            height: 70px;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--glass-border);
        }

        /* --- Buttons & Inputs --- */
        .btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 10px 16px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

        .btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-1px);
        }

        .btn-primary {
            background: var(--primary);
            border: none;
        }
        
        .btn-primary:hover {
            background: var(--primary-hover);
        }

        input[type="text"], input[type="password"], select, textarea {
            width: 100%;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--glass-border);
            color: var(--text-main);
            padding: 12px 16px;
            border-radius: var(--radius-md);
            outline: none;
            transition: var(--transition);
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
        }

        /* --- Chat UI --- */
        .chat-scroll-area {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 24px;
            scroll-behavior: smooth;
        }

        .message {
            display: flex;
            gap: 16px;
            max-width: 85%;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .message.user {
            margin-left: auto;
            flex-direction: row-reverse;
        }

        .msg-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary);
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .message.user .msg-avatar { background: #3b82f6; }

        .msg-content {
            background: var(--ai-msg);
            padding: 16px 20px;
            border-radius: var(--radius-lg);
            border: 1px solid var(--glass-border);
            position: relative;
            line-height: 1.6;
        }

        .message.user .msg-content {
            background: var(--user-msg);
            border: 1px solid rgba(99, 102, 241, 0.2);
        }

        .msg-actions {
            display: flex;
            gap: 8px;
            margin-top: 10px;
            opacity: 0.5;
            transition: var(--transition);
        }
        
        .msg-content:hover .msg-actions { opacity: 1; }

        /* Markdown Styles */
        .msg-content pre {
            background: #0d1117;
            padding: 16px;
            border-radius: var(--radius-md);
            overflow-x: auto;
            margin: 10px 0;
            border: 1px solid var(--glass-border);
        }
        .msg-content code { font-family: monospace; font-size: 0.9em; }
        .msg-content p { margin-bottom: 10px; }
        .msg-content p:last-child { margin-bottom: 0; }
        .msg-content table { border-collapse: collapse; width: 100%; margin: 10px 0; }
        .msg-content th, .msg-content td { border: 1px solid var(--glass-border); padding: 8px; }

        /* --- Input Area --- */
        .input-container {
            padding: 20px 24px;
            background: var(--panel-bg);
            border-top: 1px solid var(--glass-border);
            backdrop-filter: blur(16px);
        }

        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 12px;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .toolbar::-webkit-scrollbar { height: 4px; }
        .toolbar::-webkit-scrollbar-thumb { background: var(--glass-border); border-radius: 4px; }

        .input-box {
            position: relative;
            display: flex;
            align-items: flex-end;
            gap: 12px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 12px;
            transition: var(--transition);
        }

        .input-box:focus-within {
            border-color: var(--primary);
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
        }

        textarea#chat-input {
            flex: 1;
            background: transparent;
            border: none;
            box-shadow: none;
            resize: none;
            max-height: 150px;
            min-height: 24px;
            padding: 4px 8px;
        }

        .send-btn, .mic-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .send-btn { background: var(--primary); color: white; }
        .send-btn:hover { background: var(--primary-hover); transform: scale(1.05); }
        .send-btn:disabled { background: var(--glass-border); cursor: not-allowed; }

        .mic-btn { background: rgba(255, 255, 255, 0.1); color: var(--text-main); }
        .mic-btn.recording { background: var(--danger); animation: pulse 1.5s infinite; }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        /* --- Settings & Generic Pages --- */
        .page-content {
            padding: 40px;
            max-width: 800px;
            margin: 0 auto;
            width: 100%;
            overflow-y: auto;
            flex: 1;
        }

        .card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            padding: 24px;
            margin-bottom: 24px;
        }

        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; color: var(--text-muted); font-size: 0.9rem; }

        .grid-categories {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 16px;
        }

        .cat-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            padding: 20px;
            border-radius: var(--radius-md);
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }
        .cat-card:hover {
            background: rgba(99, 102, 241, 0.1);
            border-color: var(--primary);
            transform: translateY(-3px);
        }
        .cat-card i { font-size: 2rem; margin-bottom: 10px; color: var(--primary); }

        /* --- Toast Notifications --- */
        #toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 1000;
        }
        .toast {
            background: var(--panel-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            padding: 12px 20px;
            border-radius: var(--radius-md);
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            animation: slideLeft 0.3s ease forwards;
        }
        @keyframes slideLeft {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* --- Typing Indicator --- */
        .typing-indicator {
            display: flex;
            gap: 4px;
            padding: 10px 0;
        }
        .typing-dot {
            width: 8px;
            height: 8px;
            background: var(--text-muted);
            border-radius: 50%;
            animation: bounce 1.4s infinite ease-in-out both;
        }
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }
        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        /* --- Responsive --- */
        .mobile-menu-btn { display: none; background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer; }
        
        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: -280px;
                background: rgba(11, 15, 25, 0.95);
            }
            .sidebar.open { left: 0; }
            .mobile-menu-btn { display: block; }
            .message { max-width: 95%; }
            .page-content { padding: 20px; }
        }

        /* Utility */
        .hidden { display: none !important; }
        .text-gradient { background: linear-gradient(to right, #a855f7, #6366f1); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    </style>
</head>
<body>

    <!-- Backgrounds -->
    <div class="aurora"></div>
    <canvas id="particles"></canvas>

    <!-- Sidebar Navigation -->
    <aside class="sidebar glass" id="sidebar">
        <div class="logo-area">
            <i class="fa-solid fa-atom"></i> Universe AI
        </div>
        <nav class="nav-links">
            <a class="nav-item active" data-target="chat-view"><i class="fa-solid fa-message"></i> AI Chat</a>
            <a class="nav-item" data-target="explore-view"><i class="fa-solid fa-compass"></i> Explore Topics</a>
            <a class="nav-item" data-target="learning-view"><i class="fa-solid fa-graduation-cap"></i> Learning Dashboard</a>
            <a class="nav-item" data-target="history-view"><i class="fa-solid fa-clock-rotate-left"></i> History</a>
            <a class="nav-item" data-target="bookmarks-view"><i class="fa-solid fa-bookmark"></i> Bookmarks</a>
            <a class="nav-item" data-target="notes-view"><i class="fa-solid fa-note-sticky"></i> Notes</a>
            <a class="nav-item" data-target="settings-view"><i class="fa-solid fa-gear"></i> Settings</a>
            <a class="nav-item" data-target="about-view"><i class="fa-solid fa-circle-info"></i> About</a>
        </nav>
    </aside>

    <!-- Main Content Area -->
    <main class="main-content">
        
        <!-- Header -->
        <header class="top-nav glass">
            <button class="mobile-menu-btn" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
            <div id="header-title" style="font-weight: 600; font-size: 1.1rem;">AI Chat</div>
            <div style="display:flex; gap:10px;">
                <button class="btn" onclick="clearChat()" title="Clear Chat" id="btn-clear"><i class="fa-solid fa-trash"></i></button>
                <button class="btn" onclick="exportChat()" title="Export Chat" id="btn-export"><i class="fa-solid fa-download"></i></button>
            </div>
        </header>

        <!-- View: AI Chat -->
        <div id="chat-view" class="view-container active">
            <div class="chat-scroll-area" id="chat-box">
                <!-- Welcome Message -->
                <div class="message">
                    <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
                    <div class="msg-content">
                        <p>Hello! I am Universe AI. How can I assist you today?</p>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin-top:10px;">Please ensure your API keys are configured in Settings.</p>
                    </div>
                </div>
            </div>

            <div class="input-container">
                <div class="toolbar" id="learning-modes">
                    <button class="btn btn-sm" onclick="setMode('Normal')"><i class="fa-solid fa-wand-magic-sparkles"></i> Normal</button>
                    <button class="btn btn-sm" onclick="setMode('Simple')"><i class="fa-solid fa-child-reaching"></i> Simple</button>
                    <button class="btn btn-sm" onclick="setMode('Beginner')"><i class="fa-solid fa-seedling"></i> Beginner</button>
                    <button class="btn btn-sm" onclick="setMode('Student')"><i class="fa-solid fa-book-open"></i> Student</button>
                    <button class="btn btn-sm" onclick="setMode('Advanced')"><i class="fa-solid fa-microscope"></i> Advanced</button>
                    <button class="btn btn-sm" onclick="setMode('Expert')"><i class="fa-solid fa-brain"></i> Expert</button>
                </div>
                
                <div class="input-box">
                    <button class="mic-btn" id="mic-btn" onclick="toggleVoice()"><i class="fa-solid fa-microphone"></i></button>
                    <textarea id="chat-input" rows="1" placeholder="Type a message... (Shift+Enter for new line)"></textarea>
                    <button class="send-btn" id="send-btn" onclick="handleSend()"><i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <!-- View: Explore Topics -->
        <div id="explore-view" class="view-container">
            <div class="page-content">
                <h1 class="text-gradient" style="margin-bottom: 24px;">Explore Topics</h1>
                <div class="grid-categories" id="categories-grid">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- View: Settings -->
        <div id="settings-view" class="view-container">
            <div class="page-content">
                <h1 class="text-gradient" style="margin-bottom: 24px;">API Settings</h1>
                
                <div class="card">
                    <h3>AI Provider Selection</h3>
                    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.9rem;">Choose the AI engine you want to power Universe AI.</p>
                    <div class="form-group">
                        <select id="provider-select" onchange="updateModelOptions()">
                            <option value="openai">OpenAI</option>
                            <option value="gemini">Google Gemini</option>
                            <option value="openrouter">OpenRouter</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>AI Model</label>
                        <select id="model-select"></select>
                    </div>
                </div>

                <div class="card">
                    <h3>API Keys (Local Storage)</h3>
                    <p style="color: var(--text-muted); margin-bottom: 16px; font-size: 0.9rem;">Keys are stored securely in your browser's LocalStorage.</p>
                    
                    <div class="form-group">
                        <label>OpenAI API Key</label>
                        <input type="password" id="key-openai" placeholder="sk-...">
                    </div>
                    <div class="form-group">
                        <label>Google Gemini API Key</label>
                        <input type="password" id="key-gemini" placeholder="AIzaSy...">
                    </div>
                    <div class="form-group">
                        <label>OpenRouter API Key</label>
                        <input type="password" id="key-openrouter" placeholder="sk-or-v1-...">
                    </div>
                    
                    <div style="display: flex; gap: 10px; margin-top: 20px;">
                        <button class="btn btn-primary" onclick="saveSettings()">Save Configuration</button>
                        <button class="btn" onclick="testConnection()">Test Connection</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Placeholder Views for completeness -->
        <div id="learning-view" class="view-container"><div class="page-content"><h2>Learning Dashboard</h2><p>Analytics and progress tracking coming soon.</p></div></div>
        <div id="history-view" class="view-container"><div class="page-content"><h2>Chat History</h2><div id="history-list" class="grid-categories"></div></div></div>
        <div id="bookmarks-view" class="view-container"><div class="page-content"><h2>Bookmarks</h2><p>Saved messages will appear here.</p></div></div>
        <div id="notes-view" class="view-container"><div class="page-content"><h2>Notes</h2><textarea class="card" style="width:100%; height: 300px; background: rgba(0,0,0,0.2)" placeholder="Jot down your notes here..."></textarea></div></div>
        <div id="about-view" class="view-container">
            <div class="page-content text-center" style="text-align: center;">
                <i class="fa-solid fa-atom" style="font-size: 4rem; color: var(--primary); margin-bottom: 20px;"></i>
                <h1 class="text-gradient">Universe AI</h1>
                <p style="color: var(--text-muted); margin-top: 10px;">A premium, single-file AI frontend built with vanilla HTML/CSS/JS.</p>
                <p style="margin-top: 20px;">Version 1.0.0</p>
            </div>
        </div>

    </main>

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <script>
        /* ==========================================================================
           1. CORE STATE & INITIALIZATION
           ========================================================================== */
        const state = {
            activeView: 'chat-view',
            provider: 'openai',
            model: 'gpt-3.5-turbo',
            keys: { openai: '', gemini: '', openrouter: '' },
            history: [],
            currentMode: 'Normal',
            isRecording: false,
            isGenerating: false
        };

        const models = {
            openai: ['gpt-3.5-turbo', 'gpt-4', 'gpt-4o'],
            gemini: ['gemini-1.5-flash', 'gemini-1.5-pro'],
            openrouter: ['anthropic/claude-3-haiku', 'meta-llama/llama-3-8b-instruct', 'google/gemini-flash-1.5']
        };

        const categories = [
            { icon: 'fa-user-astronaut', name: 'Astronomy', prompt: 'Tell me fascinating facts about astronomy and the universe.' },
            { icon: 'fa-earth-americas', name: 'Earth', prompt: 'Explain the geology and ecosystems of Earth.' },
            { icon: 'fa-atom', name: 'Physics', prompt: 'Explain a core concept in quantum physics simply.' },
            { icon: 'fa-flask', name: 'Chemistry', prompt: 'What are some amazing chemical reactions?' },
            { icon: 'fa-dna', name: 'Biology', prompt: 'Explain human DNA and genetics basics.' },
            { icon: 'fa-calculator', name: 'Mathematics', prompt: 'Share a beautiful mathematical theorem.' },
            { icon: 'fa-landmark', name: 'History', prompt: 'Summarize a pivotal moment in ancient history.' },
            { icon: 'fa-microchip', name: 'Technology', prompt: 'What is the future of emerging technologies?' },
            { icon: 'fa-code', name: 'Programming', prompt: 'Write a basic web server in Node.js and explain it.' },
            { icon: 'fa-brain', name: 'AI', prompt: 'Explain how Large Language Models work.' },
            { icon: 'fa-chart-line', name: 'Business', prompt: 'What are the key principles of a successful startup?' },
            { icon: 'fa-coins', name: 'Finance', prompt: 'Explain the basics of investing and compound interest.' },
            { icon: 'fa-head-side-virus', name: 'Psychology', prompt: 'Explain a common cognitive bias.' },
            { icon: 'fa-book-journal-whills', name: 'Philosophy', prompt: 'What is the meaning of stoicism?' }
        ];

        document.addEventListener('DOMContentLoaded', () => {
            initParticles();
            loadSettings();
            initCategories();
            setupTextareaAutoResize();
            setupKeyboardShortcuts();
            
            // Configure Marked.js for Code Highlighting
            marked.setOptions({
                highlight: function(code, lang) {
                    const language = hljs.getLanguage(lang) ? lang : 'plaintext';
                    return hljs.highlight(code, { language }).value;
                },
                langPrefix: 'hljs language-'
            });
        });

        /* ==========================================================================
           2. UI & ROUTING
           ========================================================================== */
        document.querySelectorAll('.nav-item').forEach(link => {
            link.addEventListener('click', (e) => {
                const target = e.currentTarget.getAttribute('data-target');
                
                // Update active link
                document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
                e.currentTarget.classList.add('active');
                
                // Switch view
                document.querySelectorAll('.view-container').forEach(view => view.classList.remove('active'));
                document.getElementById(target).classList.add('active');
                
                // Update Header
                document.getElementById('header-title').innerText = e.currentTarget.innerText;
                
                // Toggle action buttons visibility
                const showActions = target === 'chat-view';
                document.getElementById('btn-clear').style.display = showActions ? 'inline-flex' : 'none';
                document.getElementById('btn-export').style.display = showActions ? 'inline-flex' : 'none';

                if(window.innerWidth <= 768) toggleSidebar(); // Close mobile sidebar
            });
        });

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        function showToast(msg, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-check-circle' : 'fa-triangle-exclamation'}" style="color: var(--${type})"></i> ${msg}`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
        }

        function initCategories() {
            const grid = document.getElementById('categories-grid');
            categories.forEach(cat => {
                const div = document.createElement('div');
                div.className = 'cat-card';
                div.innerHTML = `<i class="fa-solid ${cat.icon}"></i><h4>${cat.name}</h4>`;
                div.onclick = () => {
                    document.querySelector('[data-target="chat-view"]').click();
                    document.getElementById('chat-input').value = cat.prompt;
                    handleSend();
                };
                grid.appendChild(div);
            });
        }

        function setupTextareaAutoResize() {
            const tx = document.getElementById('chat-input');
            tx.setAttribute('style', 'height:' + (tx.scrollHeight) + 'px;overflow-y:hidden;');
            tx.addEventListener("input", OnInput, false);
            function OnInput() {
                this.style.height = 'auto';
                this.style.height = (this.scrollHeight) + 'px';
            }
        }

        function setupKeyboardShortcuts() {
            const input = document.getElementById('chat-input');
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    handleSend();
                }
            });
        }

        function setMode(mode) {
            state.currentMode = mode;
            document.querySelectorAll('#learning-modes .btn').forEach(b => {
                b.style.borderColor = b.innerText.includes(mode) ? 'var(--primary)' : 'var(--glass-border)';
            });
            showToast(`Learning Mode set to: ${mode}`);
        }

        /* ==========================================================================
           3. CHAT & AI INTEGRATION
           ========================================================================== */
        async function handleSend() {
            if (state.isGenerating) return;
            const inputEl = document.getElementById('chat-input');
            const text = inputEl.value.trim();
            if (!text) return;

            // Check API Keys
            if (!state.keys[state.provider]) {
                showToast(`Please configure your ${state.provider.toUpperCase()} API key in settings.`, 'danger');
                document.querySelector('[data-target="settings-view"]').click();
                return;
            }

            // Append User Message
            appendMessage('user', text);
            inputEl.value = '';
            inputEl.style.height = 'auto';
            state.history.push({ role: 'user', content: text });

            // Create AI placeholder
            const aiMsgId = 'msg-' + Date.now();
            appendMessage('ai', '<div class="typing-indicator"><div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div></div>', aiMsgId);
            
            state.isGenerating = true;
            document.getElementById('send-btn').disabled = true;

            try {
                const response = await callAIProvider(text);
                state.history.push({ role: 'assistant', content: response });
                await simulateStream(response, aiMsgId);
                saveHistory();
            } catch (error) {
                document.getElementById(aiMsgId).querySelector('.msg-content').innerHTML = `<span style="color: var(--danger)">Error: ${error.message}</span>`;
            } finally {
                state.isGenerating = false;
                document.getElementById('send-btn').disabled = false;
            }
        }

        function appendMessage(role, content, id = null) {
            const box = document.getElementById('chat-box');
            const div = document.createElement('div');
            div.className = `message ${role}`;
            if (id) div.id = id;

            const avatar = role === 'user' ? '<i class="fa-solid fa-user"></i>' : '<i class="fa-solid fa-robot"></i>';
            
            // If it's AI, parse markdown (unless it's the loading indicator)
            let formattedContent = content;
            if (role === 'ai' && !content.includes('typing-indicator')) {
                formattedContent = marked.parse(content);
            }

            let actionsHtml = '';
            if (role === 'ai') {
                actionsHtml = `
                <div class="msg-actions">
                    <button class="btn btn-sm" onclick="copyText(this)" title="Copy"><i class="fa-solid fa-copy"></i></button>
                    <button class="btn btn-sm" onclick="speakText(this)" title="Read Aloud"><i class="fa-solid fa-volume-high"></i></button>
                </div>`;
            }

            div.innerHTML = `
                <div class="msg-avatar">${avatar}</div>
                <div style="max-width: 100%;">
                    <div class="msg-content">${formattedContent}${actionsHtml}</div>
                </div>
            `;
            box.appendChild(div);
            box.scrollTo(0, box.scrollHeight);
        }

        async function simulateStream(fullText, elementId) {
            const contentDiv = document.getElementById(elementId).querySelector('.msg-content');
            contentDiv.innerHTML = ''; 
            
            let currentText = '';
            const chunkSize = 2; // chars per tick
            
            for (let i = 0; i < fullText.length; i += chunkSize) {
                currentText += fullText.slice(i, i + chunkSize);
                contentDiv.innerHTML = marked.parse(currentText);
                
                // Highlight code blocks dynamically
                contentDiv.querySelectorAll('pre code').forEach((block) => {
                    hljs.highlightElement(block);
                });

                document.getElementById('chat-box').scrollTo(0, document.getElementById('chat-box').scrollHeight);
                await new Promise(r => setTimeout(r, 10)); // Speed of typing
            }

            // Add actions back after streaming
            contentDiv.innerHTML += `
            <div class="msg-actions">
                <button class="btn btn-sm" onclick="copyText(this)" title="Copy"><i class="fa-solid fa-copy"></i></button>
                <button class="btn btn-sm" onclick="speakText(this)" title="Read Aloud"><i class="fa-solid fa-volume-high"></i></button>
            </div>`;
        }

        /* --- API Call Routing --- */
        async function callAIProvider(prompt) {
            // Apply Learning Mode Context
            let systemPrompt = "You are Universe AI, a highly advanced, helpful, and premium assistant.";
            if (state.currentMode !== 'Normal') {
                systemPrompt += ` The user has selected the "${state.currentMode}" learning mode. Adjust your response tone, vocabulary, and depth accordingly. Include Summary, Key Points, Examples, or a Quiz if appropriate for this mode.`;
            }

            const messages = [
                { role: "system", content: systemPrompt },
                ...state.history.slice(-6), // Send last 6 messages for context
                { role: "user", content: prompt }
            ];

            if (state.provider === 'openai') {
                return await fetchOpenAI(messages);
            } else if (state.provider === 'gemini') {
                return await fetchGemini(systemPrompt, prompt); // Gemini format varies
            } else if (state.provider === 'openrouter') {
                return await fetchOpenRouter(messages);
            }
        }

        async function fetchOpenAI(messages) {
            const res = await fetch('https://api.openai.com/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${state.keys.openai}`
                },
                body: JSON.stringify({
                    model: state.model,
                    messages: messages,
                    temperature: 0.7
                })
            });
            if (!res.ok) throw new Error((await res.json()).error?.message || 'API Error');
            const data = await res.json();
            return data.choices[0].message.content;
        }

        async function fetchOpenRouter(messages) {
            const res = await fetch('https://openrouter.ai/api/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${state.keys.openrouter}`,
                    'HTTP-Referer': window.location.href,
                    'X-Title': 'Universe AI'
                },
                body: JSON.stringify({
                    model: state.model,
                    messages: messages
                })
            });
            if (!res.ok) throw new Error('OpenRouter API Error');
            const data = await res.json();
            return data.choices[0].message.content;
        }

        async function fetchGemini(systemPrompt, prompt) {
            // Gemini uses a different structure
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${state.model}:generateContent?key=${state.keys.gemini}`;
            
            // Build contents array from history
            const contents = state.history.map(msg => ({
                role: msg.role === 'user' ? 'user' : 'model',
                parts: [{ text: msg.content }]
            }));
            
            contents.push({ role: 'user', parts: [{ text: `System: ${systemPrompt}\n\nUser: ${prompt}` }] });

            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contents })
            });

            if (!res.ok) throw new Error((await res.json()).error?.message || 'Gemini API Error');
            const data = await res.json();
            return data.candidates[0].content.parts[0].text;
        }


        /* ==========================================================================
           4. SETTINGS & LOCAL STORAGE
           ========================================================================== */
        function loadSettings() {
            const savedKeys = JSON.parse(localStorage.getItem('universe_keys'));
            if (savedKeys) state.keys = savedKeys;
            
            const savedProvider = localStorage.getItem('universe_provider');
            if (savedProvider) state.provider = savedProvider;
            
            const savedModel = localStorage.getItem('universe_model');
            if (savedModel) state.model = savedModel;

            // Populate UI
            document.getElementById('key-openai').value = state.keys.openai || '';
            document.getElementById('key-gemini').value = state.keys.gemini || '';
            document.getElementById('key-openrouter').value = state.keys.openrouter || '';
            document.getElementById('provider-select').value = state.provider;
            
            updateModelOptions();
            document.getElementById('model-select').value = state.model;
        }

        function saveSettings() {
            state.keys.openai = document.getElementById('key-openai').value.trim();
            state.keys.gemini = document.getElementById('key-gemini').value.trim();
            state.keys.openrouter = document.getElementById('key-openrouter').value.trim();
            state.provider = document.getElementById('provider-select').value;
            state.model = document.getElementById('model-select').value;

            localStorage.setItem('universe_keys', JSON.stringify(state.keys));
            localStorage.setItem('universe_provider', state.provider);
            localStorage.setItem('universe_model', state.model);

            showToast('Settings saved successfully!');
        }

        function updateModelOptions() {
            const provider = document.getElementById('provider-select').value;
            const select = document.getElementById('model-select');
            select.innerHTML = '';
            models[provider].forEach(m => {
                const opt = document.createElement('option');
                opt.value = m;
                opt.innerText = m;
                select.appendChild(opt);
            });
        }

        async function testConnection() {
            saveSettings();
            showToast('Testing connection...', 'success');
            try {
                // simple hello test
                const tempHistory = state.history;
                state.history = [];
                await callAIProvider("Reply with the exact word 'Success'");
                state.history = tempHistory;
                showToast(`Connection to ${state.provider} successful!`, 'success');
            } catch (e) {
                showToast(`Connection failed: ${e.message}`, 'danger');
            }
        }

        /* --- Chat History Storage --- */
        function saveHistory() {
            localStorage.setItem('universe_history', JSON.stringify(state.history));
            updateHistoryList();
        }
        
        function clearChat() {
            if(!confirm("Clear all chat history?")) return;
            state.history = [];
            document.getElementById('chat-box').innerHTML = `
                <div class="message">
                    <div class="msg-avatar"><i class="fa-solid fa-robot"></i></div>
                    <div class="msg-content"><p>Chat cleared. How can I help?</p></div>
                </div>`;
            saveHistory();
        }

        function exportChat() {
            if(state.history.length === 0) return showToast('No chat to export', 'danger');
            let txt = 'Universe AI - Chat Export\n\n';
            state.history.forEach(m => {
                txt += `${m.role.toUpperCase()}:\n${m.content}\n\n`;
            });
            const blob = new Blob([txt], { type: 'text/plain' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = `UniverseAI_Chat_${new Date().getTime()}.txt`;
            a.click();
            showToast('Chat exported!');
        }

        function updateHistoryList() {
            // basic implementation for History tab
            const list = document.getElementById('history-list');
            list.innerHTML = '';
            if(state.history.length > 0) {
                const item = document.createElement('div');
                item.className = 'cat-card';
                item.innerHTML = `<i class="fa-solid fa-comments"></i><h4>Current Session</h4><p>${state.history.length} messages</p>`;
                list.appendChild(item);
            }
        }

        /* ==========================================================================
           5. UTILITIES (Voice, Copy)
           ========================================================================== */
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        let recognition = null;
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.interimResults = false;
            
            recognition.onresult = (event) => {
                const text = event.results[0][0].transcript;
                document.getElementById('chat-input').value += text;
                document.getElementById('chat-input').style.height = 'auto';
                document.getElementById('chat-input').style.height = document.getElementById('chat-input').scrollHeight + 'px';
            };
            
            recognition.onend = () => {
                state.isRecording = false;
                document.getElementById('mic-btn').classList.remove('recording');
            };
        }

        function toggleVoice() {
            if (!recognition) return showToast('Voice input not supported in this browser.', 'danger');
            
            if (state.isRecording) {
                recognition.stop();
            } else {
                recognition.start();
                state.isRecording = true;
                document.getElementById('mic-btn').classList.add('recording');
                showToast('Listening...');
            }
        }

        function copyText(btn) {
            // Traverse up to msg-content, clone to avoid copying action buttons text, then extract innerText
            const contentDiv = btn.closest('.msg-content').cloneNode(true);
            const actions = contentDiv.querySelector('.msg-actions');
            if (actions) actions.remove();
            
            navigator.clipboard.writeText(contentDiv.innerText).then(() => {
                const icon = btn.querySelector('i');
                icon.className = 'fa-solid fa-check';
                setTimeout(() => icon.className = 'fa-solid fa-copy', 2000);
            });
        }

        function speakText(btn) {
            if (!window.speechSynthesis) return showToast('Speech synthesis not supported.', 'danger');
            window.speechSynthesis.cancel(); // Stop current
            
            const contentDiv = btn.closest('.msg-content').cloneNode(true);
            const actions = contentDiv.querySelector('.msg-actions');
            if (actions) actions.remove();

            const utterance = new SpeechSynthesisUtterance(contentDiv.innerText);
            utterance.rate = 1.0;
            utterance.pitch = 1.0;
            window.speechSynthesis.speak(utterance);
        }

        /* ==========================================================================
           6. CANVAS PARTICLES
           ========================================================================== */
        function initParticles() {
            const canvas = document.getElementById('particles');
            const ctx = canvas.getContext('2d');
            let particlesArray;

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            class Particle {
                constructor(x, y, directionX, directionY, size, color) {
                    this.x = x;
                    this.y = y;
                    this.directionX = directionX;
                    this.directionY = directionY;
                    this.size = size;
                    this.color = color;
                }
                draw() {
                    ctx.beginPath();
                    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2, false);
                    ctx.fillStyle = this.color;
                    ctx.fill();
                }
                update() {
                    if (this.x > canvas.width || this.x < 0) this.directionX = -this.directionX;
                    if (this.y > canvas.height || this.y < 0) this.directionY = -this.directionY;
                    this.x += this.directionX;
                    this.y += this.directionY;
                    this.draw();
                }
            }

            function init() {
                particlesArray = [];
                let numberOfParticles = (canvas.height * canvas.width) / 15000;
                for (let i = 0; i < numberOfParticles; i++) {
                    let size = (Math.random() * 2) + 0.5;
                    let x = (Math.random() * ((innerWidth - size * 2) - (size * 2)) + size * 2);
                    let y = (Math.random() * ((innerHeight - size * 2) - (size * 2)) + size * 2);
                    let directionX = (Math.random() * 0.4) - 0.2;
                    let directionY = (Math.random() * 0.4) - 0.2;
                    let color = 'rgba(255,255,255,0.15)';
                    particlesArray.push(new Particle(x, y, directionX, directionY, size, color));
                }
            }

            function animate() {
                requestAnimationFrame(animate);
                ctx.clearRect(0, 0, innerWidth, innerHeight);
                for (let i = 0; i < particlesArray.length; i++) {
                    particlesArray[i].update();
                }
            }

            window.addEventListener('resize', () => {
                canvas.width = innerWidth;
                canvas.height = innerHeight;
                init();
            });

            init();
            animate();
        }
    </script>
</body>
</html>